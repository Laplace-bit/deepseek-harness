{
  "name": "@deepseek-ai/dsh-sppm-ui-embed",
  "description": "Browser UI entry that mounts the Harness client inside the SPPM Vue host",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sppm/ui-embed"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/assistant.js",
    "lib/style.css",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "tsdown --env.DSH_BUILD_FACE client && node scripts/patch-browser-bundle.mjs && node scripts/patch-browser-style.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-sppm-page-bridge": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@shikijs/langs": "^4.3.1",
    "@tsdown/css": "^0.23.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "immer": "^10.2.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "shiki": "^4.3.1",
    "tsdown": "^0.22.2",
    "zustand": "~4.4.7"
  }
}
